# Ponto 24 Académico — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores

# Segurança
SECRET_KEY=muda-esta-chave-para-algo-seguro-em-producao

# Base de dados (SQLite por defeito, muda para PostgreSQL em produção)
DATABASE_URL=sqlite:///ponto24.db

# Configurações de upload
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=20

# Ambiente (development | production)
FLASK_ENV=development
FLASK_DEBUG=1

# Email (opcional, para notificações futuras)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=suapassword
