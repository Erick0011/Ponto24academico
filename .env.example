# Ponto 24 Académico — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores

# Segurança
SECRET_KEY=muda-esta-chave-para-algo-seguro-em-producao

# Base de dados (SQLite por defeito, muda para PostgreSQL em produção)
DATABASE_URL=sqlite:///ponto24.db

# Configurações de upload
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=20

# Ambiente (development | production)
FLASK_ENV=development
FLASK_DEBUG=1

# Email SMTP — descomenta e preenche para ativar envio de emails
# Para Gmail: usa uma "App Password" em myaccount.google.com/apppasswords
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=seuemail@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_DEFAULT_SENDER=noreply@ponto24.ao

# Cloudflare R2 (opcional — armazenamento de ficheiros em produção; se omitido, usa disco local)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ponto24-materiais
